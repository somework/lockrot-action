# The lockrot release this action runs when the `version` input is left empty, and the sha256 of
# its lockrot.phar as published beside it. Both are checked on every run. Updated by
# .github/workflows/update-lockrot.yml; the Docker image is built from the same two values.
LOCKROT_VERSION=0.11.0
LOCKROT_SHA256=d8196dbe5b5dbe4aa8cb626f5b135e3cb0ccd8d6989b587b8fe05eee8ceb301a
