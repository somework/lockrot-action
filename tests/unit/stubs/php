#!/usr/bin/env bash
# php stand-in for the unit tests: records its arguments, answers --version, and prints a canned
# report whose exit code is $PHP_STUB_EXIT, and writes a markdown summary or the canned report
# where --output asks for one.
printf '%s\n' "$*" >> "${PHP_STUB_LOG:-/dev/null}"
# The action reads composer.json with `php -n -r`: the real PHP after this directory on PATH runs it.
if [ "${1:-}" = "-n" ] && [ "${2:-}" = "-r" ]; then
  stubs=$(cd "$(dirname "$0")" && pwd)
  IFS=:
  for dir in $PATH; do
    [ "$dir" != "$stubs" ] && [ -x "$dir/php" ] && exec "$dir/php" "$@"
  done
  exit 127
fi
if [ "${1:-}" = "-r" ]; then
  case $2 in *PHP_VERSION_ID*) exit "${PHP_STUB_TOO_OLD:-0}" ;; esac
  printf '8.4.0'
  exit 0
fi
for argument in "$@"; do
  case $argument in
    --version) printf 'lockrot %s\n' "${PHP_STUB_VERSION:-9.9.9}"; exit 0 ;;
  esac
done
for argument in "$@"; do
  case $argument in
    --output=markdown:*) printf '### lockrot: stub summary\n\n- note: offline: repository metadata served from Composer'"'"'s cache\n- note: kept\n' > "${argument#--output=markdown:}" ;;
    --output=*:*) printf '::warning file=composer.lock,line=12,title=lockrot%%3A silent (critical)::acme/pkg 1.0.0: stub evidence\n1 packages checked\n' > "${argument#--output=*:}" ;;
  esac
done
for argument in "$@"; do
  case $argument in
    --format=markdown)
      printf '### lockrot: stub summary\n\n- note: offline: repository metadata served from Composer'"'"'s cache\n- note: kept\n'
      exit "${PHP_STUB_SUMMARY_EXIT:-0}"
      ;;
  esac
done
printf '::warning file=composer.lock,line=12,title=lockrot%%3A silent (critical)::acme/pkg 1.0.0: stub evidence\n'
printf '1 packages checked\n'
exit "${PHP_STUB_EXIT:-0}"
